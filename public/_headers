# Configuración de cabeceras HTTP para Render Static Site y CDNs
# Optimización crítica para Unity WebGL: Permite descompresión nativa por hardware en el navegador

# 1. Archivo de datos binarios y escenas 3D (Gzip)
/UniMapBuild/Build/*.data.unityweb
  Content-Type: application/octet-stream
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 2. Módulo compilado WebAssembly (Gzip)
/UniMapBuild/Build/*.wasm.unityweb
  Content-Type: application/wasm
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 3. Código JavaScript del Framework Unity (Gzip)
/UniMapBuild/Build/*.framework.js.unityweb
  Content-Type: application/javascript
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 4. Cargador inicial del motor Unity WebGL
/UniMapBuild/Build/*.loader.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 5. Recursos estáticos de React (JS/CSS versionados por hash)
/static/*
  Cache-Control: public, max-age=31536000, immutable

# 6. Documento HTML principal (Siempre fresco)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
